# ============================================
# AsihHealth - Environment Configuration
# Copy file ini menjadi .env lalu isi sesuai kebutuhan
# ============================================

# === LLM Configuration ===
# Pilihan: ollama (gratis), groq, gemini, openrouter
LLM_PROVIDER=ollama

# Ollama (recommended - 100% gratis)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b          # atau llama3.1:8b, gemma2:9b

# Groq (sangat murah & cepat) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile   # Recommended: llama-3.3-70b-versatile atau llama-3.1-8b-instant

# Google Gemini (sangat murah)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# === TTS Configuration ===
# edge-tts (default, gratis, bagus kualitas ID, tapi kadang kurang reliable karena online)
TTS_PROVIDER=edge-tts
TTS_VOICE=id-ID-AndikaNeural     # Lihat daftar: python scripts/list_voices.py

# Untuk reliability lebih baik (scheduler/daily), gunakan local:
# 
# PERINGATAN: TTS (untuk xtts) HANYA BISA di Python 3.9 atau 3.10
# Kalau kamu pakai Python 3.11+, 3.12, 3.13, atau 3.14 → pip install TTS akan gagal.
# Lihat QUICKSTART.md → "PENTING: Python Version"
#
# TTS_PROVIDER=xtts
# TTS_REFERENCE_AUDIO=assets/voices/reference/narator.wav   # rekam 15-30 detik suara jelas ID
# Instalasi (dengan Python 3.10):
#   py -3.10 -m pip install TTS
#   py -3.10 -m pip install torch torchaudio --index-url https://download.pytorch.org/whl/cpu
# Model ~2GB akan download otomatis pertama kali.

# Atau Piper (paling cepat & reliable offline):
# TTS_PROVIDER=piper
# PIPER_MODEL=assets/voices/piper/id_ID-news_tts-medium.onnx
# PIPER_CONFIG=assets/voices/piper/id_ID-news_tts-medium.onnx.json
# Instalasi: pip install piper-tts
# Windows: install juga espeak-ng (https://github.com/espeak-ng/espeak-ng/releases)

# === Whisper (Subtitle) ===
WHISPER_MODEL=base               # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu               # cpu atau cuda (kalau punya NVIDIA GPU)

# === YouTube Upload ===
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_CREDENTIALS=token.json

# === Paths ===
OUTPUT_DIR=output
ASSETS_DIR=assets

# === Video Settings ===
VIDEO_RESOLUTION=1080p           # 720p atau 1080p
VIDEO_FPS=30
VIDEO_BITRATE=6000k

# === Cost Control ===
MAX_SCRIPT_WORDS=1200            # Batasi panjang script biar hemat (token + waktu render)

# === Free Stock Footage (Pexels) - Highly Recommended ===
# Dapatkan API key gratis di: https://www.pexels.com/api/
PEXELS_API_KEY=
USE_STOCK_VISUALS=true           # true = pakai gambar stock + Ken Burns (direkomendasikan)
NUM_STOCK_IMAGES=7               # Jumlah gambar yang diunduh per video
USE_PEXELS_VIDEOS=false          # Video clips lebih berat, default false (pakai gambar saja)

# === Thumbnail ===
THUMBNAIL_ACCENT_COLOR=220,38,38 # RGB untuk aksen (merah kesehatan)

# === YouTube Upload (opsional) ===
YOUTUBE_PRIVACY_DEFAULT=private
