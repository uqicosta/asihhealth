# ============================================
# AsihHealth - Environment Configuration
# Copy file ini menjadi .env lalu isi sesuai kebutuhan
# ============================================

# === LLM Configuration ===
# Pilihan: ollama (gratis), groq, gemini, openrouter
LLM_PROVIDER=ollama

# Ollama (recommended - 100% gratis)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b          # atau llama3.1:8b, gemma2:9b

# Groq (sangat murah & cepat) - https://console.groq.com/keys
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx

# Google Gemini (sangat murah)
# GEMINI_API_KEY=AIzaSy...

# === TTS Configuration ===
# edge-tts adalah default (gratis)
TTS_PROVIDER=edge-tts
TTS_VOICE=id-ID-AndikaNeural     # Lihat daftar voice: edge-tts --list-voices

# === Whisper (Subtitle) ===
WHISPER_MODEL=base               # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu               # cpu atau cuda (kalau punya NVIDIA GPU)

# === YouTube Upload ===
YOUTUBE_CLIENT_SECRETS=client_secrets.json
YOUTUBE_CREDENTIALS=token.json

# === Paths ===
OUTPUT_DIR=output
ASSETS_DIR=assets

# === Video Settings ===
VIDEO_RESOLUTION=1080p           # 720p atau 1080p
VIDEO_FPS=30
VIDEO_BITRATE=6000k

# === Cost Control ===
MAX_SCRIPT_WORDS=1200            # Batasi panjang script biar hemat (token + waktu render)

# === Free Stock Footage (Pexels) - Highly Recommended ===
# Dapatkan API key gratis di: https://www.pexels.com/api/
PEXELS_API_KEY=
USE_STOCK_VISUALS=true           # true = pakai gambar stock + Ken Burns (direkomendasikan)
NUM_STOCK_IMAGES=7               # Jumlah gambar yang diunduh per video
USE_PEXELS_VIDEOS=false          # Video clips lebih berat, default false (pakai gambar saja)

# === Thumbnail ===
THUMBNAIL_ACCENT_COLOR=220,38,38 # RGB untuk aksen (merah kesehatan)

# === YouTube Upload (opsional) ===
YOUTUBE_PRIVACY_DEFAULT=private
